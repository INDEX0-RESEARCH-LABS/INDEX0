# ==============================================================================
# INDEX0 AI — Master Platform Environment Configuration Template
# ==============================================================================
# Copy this file to .env before starting development:
#   cp .env.example .env
# Never commit .env or actual production credentials to source control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Runtime & Environment Settings
# ------------------------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=debug

# ------------------------------------------------------------------------------
# 2. Primary Database (PostgreSQL 16)
# ------------------------------------------------------------------------------
DATABASE_URL="postgresql://index0:index0_secret@localhost:5432/index0_dev?schema=public"
POSTGRES_USER=index0
POSTGRES_PASSWORD=index0_secret
POSTGRES_DB=index0_dev
POSTGRES_PORT=5432

# ------------------------------------------------------------------------------
# 3. Columnar Telemetry & Analytics Engine (ClickHouse)
# ------------------------------------------------------------------------------
CLICKHOUSE_URL="http://localhost:8123"
CLICKHOUSE_HOST=localhost
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=clickhouse_secret
CLICKHOUSE_DB=index0_analytics

# ------------------------------------------------------------------------------
# 4. Identity & Authentication (Zitadel OIDC)
# ------------------------------------------------------------------------------
ZITADEL_ISSUER="http://localhost:8085"
ZITADEL_EXTERNAL_URL="http://localhost:8085"
ZITADEL_CLIENT_ID=your_zitadel_client_id_placeholder
ZITADEL_CLIENT_SECRET=your_zitadel_client_secret_placeholder
ZITADEL_KEY_PATH="./infra/zitadel/key.json"

# Social Identity Providers (GitHub & Google)
AUTH_GITHUB_CLIENT_ID=your_github_client_id_placeholder
AUTH_GITHUB_CLIENT_SECRET=your_github_client_secret_placeholder
AUTH_GOOGLE_CLIENT_ID=your_google_client_id_placeholder
AUTH_GOOGLE_CLIENT_SECRET=your_google_client_secret_placeholder

# Mobile Number OTP & SMS Gateway (Twilio / MSG91 / Fast2SMS / Mock)
SMS_PROVIDER=mock
SMS_API_KEY=your_sms_api_key_placeholder
SMS_SENDER_ID=INDEX0
TWILIO_ACCOUNT_SID=your_twilio_account_sid_placeholder
TWILIO_AUTH_TOKEN=your_twilio_auth_token_placeholder
TWILIO_PHONE_NUMBER="+15551234567"

# ------------------------------------------------------------------------------
# 5. API Gateway (Caddy Reverse Proxy & Unified Entrypoint)
# ------------------------------------------------------------------------------
GATEWAY_PORT=8000
GATEWAY_HOST=0.0.0.0

# ------------------------------------------------------------------------------
# 6. Durable Workflow Orchestration (Temporal)
# ------------------------------------------------------------------------------
TEMPORAL_HOST_PORT="localhost:7233"
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=index0-task-queue
TEMPORAL_UI_PORT=8233

# ------------------------------------------------------------------------------
# 7. Isolated Sandbox Manager (Local Docker / E2B Option)
# ------------------------------------------------------------------------------
SANDBOX_MANAGER_PORT=4001
E2B_API_KEY=e2b_api_key_placeholder
SANDBOX_TIMEOUT_MS=300000
SANDBOX_MAX_MEMORY_MB=2048
SANDBOX_MAX_CPU_CORES=2

# ------------------------------------------------------------------------------
# 8. Autonomous Agent Workbench (OpenHands All-in-One Container)
# ------------------------------------------------------------------------------
OPENHANDS_PORT=3000
LLM_MODEL="anthropic/claude-3-5-sonnet-20241022"
LLM_API_KEY=your_llm_api_key_placeholder
LLM_BASE_URL=
WORKSPACE_BASE="./workspace"
SANDBOX_RUNTIME_CONTAINER_IMAGE="docker.all-hands.dev/all-hands-ai/runtime:0.18-nikolaik"

# ------------------------------------------------------------------------------
# 9. Model Context Protocol (MCP Host)
# ------------------------------------------------------------------------------
MCP_HOST_PORT=4003
MCP_ALLOWED_PATHS="/home/darion-dev/Dev/Incubator/INDEX0"

# ------------------------------------------------------------------------------
# 10. Sovereign Deployment Engine (Coolify)
# ------------------------------------------------------------------------------
COOLIFY_API_URL="http://localhost:8000/api/v1"
COOLIFY_API_TOKEN=your_coolify_api_token_placeholder

# ------------------------------------------------------------------------------
# 11. Real-time Event Metering (OpenMeter)
# ------------------------------------------------------------------------------
OPENMETER_ENDPOINT="http://localhost:8888"
OPENMETER_API_KEY=your_openmeter_api_key_placeholder

# ------------------------------------------------------------------------------
# 12. Subscription Management & Rating Engine (Lago)
# ------------------------------------------------------------------------------
LAGO_API_URL="http://localhost:3000/api/v1"
LAGO_API_KEY=your_lago_api_key_placeholder

# ------------------------------------------------------------------------------
# 13. Sovereign Payment Rails (Razorpay)
# ------------------------------------------------------------------------------
RAZORPAY_KEY_ID=rzp_test_your_razorpay_key_id_placeholder
RAZORPAY_KEY_SECRET=your_razorpay_secret_key_placeholder
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_placeholder
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_razorpay_key_id_placeholder
RAZORPAY_CURRENCY=INR

# ------------------------------------------------------------------------------
# 14. Sovereign CRM (Twenty)
# ------------------------------------------------------------------------------
TWENTY_API_URL="http://localhost:3002"
TWENTY_API_KEY=your_twenty_api_key_placeholder

# ------------------------------------------------------------------------------
# 15. Product Analytics & Feature Flags (PostHog)
# ------------------------------------------------------------------------------
POSTHOG_API_KEY=phc_your_posthog_api_key_placeholder
POSTHOG_HOST="https://app.posthog.com"

# ------------------------------------------------------------------------------
# 16. Programmatic Social Dispatch (Postiz)
# ------------------------------------------------------------------------------
POSTIZ_API_URL="http://localhost:5000"
POSTIZ_API_KEY=your_postiz_api_key_placeholder

# ------------------------------------------------------------------------------
# 17. Transactional & Developer Newsletters (Listmonk)
# ------------------------------------------------------------------------------
LISTMONK_API_URL="http://localhost:9001"
LISTMONK_API_USER=listmonk_admin
LISTMONK_API_PASSWORD=your_listmonk_password_placeholder

# ------------------------------------------------------------------------------
# 18. Firecracker MicroVM Sandbox & Provider Selection
# ------------------------------------------------------------------------------
SANDBOX_PROVIDER="e2b" # e2b | firecracker | docker | mock
FIRECRACKER_BIN="/usr/local/bin/firecracker"
FIRECRACKER_KERNEL="/var/lib/firecracker/vmlinux"
FIRECRACKER_ROOTFS="/var/lib/firecracker/rootfs.ext4"
FIRECRACKER_SOCKET_PREFIX="/tmp/firecracker-"

# ------------------------------------------------------------------------------
# 19. Model Router & Multi-Provider Fallbacks (LiteLLM)
# ------------------------------------------------------------------------------
LITELLM_PROXY_URL="http://localhost:4000"
LITELLM_MASTER_KEY="sk-index0-litellm-dev"
OPENAI_API_KEY="your_openai_api_key_placeholder"
ANTHROPIC_API_KEY="your_anthropic_api_key_placeholder"

# ------------------------------------------------------------------------------
# 20. Persistent Structured Agent Memory (Letta / MemGPT)
# ------------------------------------------------------------------------------
LETTA_SERVER_URL="http://localhost:8283"
LETTA_SERVER_PORT=8283

# ------------------------------------------------------------------------------
# 21. Context Compression & Retrieval (OpenViking Protocol)
# ------------------------------------------------------------------------------
VIKING_CACHE_TTL_SECONDS=3600
VIKING_DEFAULT_TIER="L1_STRUCTURAL" # L0_ABSTRACT | L1_STRUCTURAL | L2_FULL

# ------------------------------------------------------------------------------
# 22. Sub-100ms Multimodal WebRTC Voice (LiveKit + Pipecat)
# ------------------------------------------------------------------------------
LIVEKIT_URL="ws://localhost:7880"
LIVEKIT_API_KEY="devkey"
LIVEKIT_API_SECRET="secret"
PIPECAT_SAMPLE_RATE=16000

# ------------------------------------------------------------------------------
# 23. Continuous Security SAST & Vulnerability Gates (Semgrep + Trivy)
# ------------------------------------------------------------------------------
SEMGREP_RULES="auto"
SEMGREP_FAIL_SEVERITY="ERROR"
TRIVY_SEVERITY_GATE="HIGH,CRITICAL"
