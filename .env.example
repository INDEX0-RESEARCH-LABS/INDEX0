# ==============================================================================
# INDEX0 AI — Master Platform Environment Configuration Template
# ==============================================================================
# Copy this file to .env before starting development:
#   cp .env.example .env
# Never commit .env or actual production credentials to source control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Runtime & Environment Settings
# ------------------------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=debug

# ------------------------------------------------------------------------------
# 2. Primary Database (PostgreSQL 16)
# ------------------------------------------------------------------------------
DATABASE_URL="postgresql://index0:index0_secret@localhost:5432/index0_dev?schema=public"
POSTGRES_USER=index0
POSTGRES_PASSWORD=index0_secret
POSTGRES_DB=index0_dev
POSTGRES_PORT=5432

# ------------------------------------------------------------------------------
# 3. Columnar Telemetry & Analytics Engine (ClickHouse)
# ------------------------------------------------------------------------------
CLICKHOUSE_URL="http://localhost:8123"
CLICKHOUSE_HOST=localhost
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=clickhouse_secret
CLICKHOUSE_DB=index0_analytics

# ------------------------------------------------------------------------------
# 4. Identity & Authentication (Zitadel OIDC)
# ------------------------------------------------------------------------------
ZITADEL_ISSUER="http://localhost:8085"
ZITADEL_EXTERNAL_URL="http://localhost:8085"
ZITADEL_CLIENT_ID=your_zitadel_client_id_placeholder
ZITADEL_CLIENT_SECRET=your_zitadel_client_secret_placeholder
ZITADEL_KEY_PATH="./infra/zitadel/key.json"

# ------------------------------------------------------------------------------
# 5. API Gateway (Go Entrypoint)
# ------------------------------------------------------------------------------
GATEWAY_PORT=8080
GATEWAY_HOST=0.0.0.0
GATEWAY_CORS_ALLOWED_ORIGINS="http://localhost:3000,http://localhost:5173"

# ------------------------------------------------------------------------------
# 6. Durable Workflow Orchestration (Temporal)
# ------------------------------------------------------------------------------
TEMPORAL_HOST_PORT="localhost:7233"
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=index0-task-queue
TEMPORAL_UI_PORT=8233

# ------------------------------------------------------------------------------
# 7. Isolated Sandbox Manager (E2B MicroVMs)
# ------------------------------------------------------------------------------
SANDBOX_MANAGER_PORT=4001
E2B_API_KEY=e2b_api_key_placeholder
SANDBOX_TIMEOUT_MS=300000
SANDBOX_MAX_MEMORY_MB=2048
SANDBOX_MAX_CPU_CORES=2

# ------------------------------------------------------------------------------
# 8. Autonomous Agent Host & OpenHands Runtime
# ------------------------------------------------------------------------------
AGENT_HOST_PORT=4002
OPENHANDS_RUNTIME_URL="http://localhost:3001"
ANTHROPIC_API_KEY=your_anthropic_api_key_placeholder
OPENAI_API_KEY=your_openai_api_key_placeholder
OPENROUTER_API_KEY=your_openrouter_api_key_placeholder

# ------------------------------------------------------------------------------
# 9. Model Context Protocol (MCP Host)
# ------------------------------------------------------------------------------
MCP_HOST_PORT=4003
MCP_ALLOWED_PATHS="/home/darion-dev/Dev/Incubator/INDEX0"

# ------------------------------------------------------------------------------
# 10. Sovereign Deployment Engine (Coolify)
# ------------------------------------------------------------------------------
COOLIFY_API_URL="http://localhost:8000/api/v1"
COOLIFY_API_TOKEN=your_coolify_api_token_placeholder

# ------------------------------------------------------------------------------
# 11. Real-time Event Metering (OpenMeter)
# ------------------------------------------------------------------------------
OPENMETER_ENDPOINT="http://localhost:8888"
OPENMETER_API_KEY=your_openmeter_api_key_placeholder

# ------------------------------------------------------------------------------
# 12. Subscription Management & Rating Engine (Lago)
# ------------------------------------------------------------------------------
LAGO_API_URL="http://localhost:3000/api/v1"
LAGO_API_KEY=your_lago_api_key_placeholder

# ------------------------------------------------------------------------------
# 13. Payment Rails (Stripe)
# ------------------------------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_placeholder
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_placeholder
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret_placeholder

# ------------------------------------------------------------------------------
# 14. Sovereign CRM (Twenty)
# ------------------------------------------------------------------------------
TWENTY_API_URL="http://localhost:3002"
TWENTY_API_KEY=your_twenty_api_key_placeholder

# ------------------------------------------------------------------------------
# 15. Product Analytics & Feature Flags (PostHog)
# ------------------------------------------------------------------------------
POSTHOG_API_KEY=phc_your_posthog_api_key_placeholder
POSTHOG_HOST="https://app.posthog.com"

# ------------------------------------------------------------------------------
# 16. Programmatic Social Dispatch (Postiz)
# ------------------------------------------------------------------------------
POSTIZ_API_URL="http://localhost:5000"
POSTIZ_API_KEY=your_postiz_api_key_placeholder

# ------------------------------------------------------------------------------
# 17. Transactional & Developer Newsletters (Listmonk)
# ------------------------------------------------------------------------------
LISTMONK_API_URL="http://localhost:9001"
LISTMONK_API_USER=listmonk_admin
LISTMONK_API_PASSWORD=your_listmonk_password_placeholder
