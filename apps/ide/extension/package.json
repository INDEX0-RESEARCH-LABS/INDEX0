{
  "name": "index0",
  "displayName": "INDEX0 AI",
  "version": "0.2.0",
  "description": "Autonomous code review and agent loop \u2014 verify before merge",
  "publisher": "index0",
  "private": true,
  "type": "commonjs",
  "main": "./dist/extension.js",
  "engines": {
    "vscode": "^1.88.0"
  },
  "categories": [
    "AI",
    "Programming Languages",
    "Other"
  ],
  "icon": "icon.png",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "index0.startAgentRun",
        "title": "Run INDEX0 Agent",
        "category": "INDEX0",
        "icon": "$(sparkle)"
      },
      {
        "command": "index0.runOnCurrentFile",
        "title": "Run INDEX0 on Current File",
        "category": "INDEX0",
        "icon": "$(play)"
      }
    ],
    "keybindings": [
      {
        "command": "index0.startAgentRun",
        "key": "ctrl+shift+i",
        "mac": "cmd+shift+i"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "index0-sidebar",
          "title": "INDEX0 AI",
          "icon": "$(symbol-event)"
        }
      ]
    },
    "views": {
      "index0-sidebar": [
        {
          "type": "webview",
          "id": "index0.agentPanel",
          "name": "Agent",
          "retainContextWhenHidden": true
        }
      ]
    },
    "menus": {
      "editor/context": [
        {
          "command": "index0.startAgentRun",
          "group": "index0",
          "when": "editorHasSelection"
        }
      ]
    },
    "configuration": {
      "title": "INDEX0 AI",
      "properties": {
        "index0.orchestratorUrl": {
          "type": "string",
          "default": "http://localhost:8000",
          "description": "Agent orchestrator URL (run ./demo/run-ui-demo.sh to start)"
        },
        "index0.model": {
          "type": "string",
          "default": "claude",
          "description": "Model route: claude | groq | gemini | openrouter"
        }
      }
    }
  },
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node build.mjs && node --test test/extension.test.cjs",
    "package": "node build.mjs && vsce package --no-dependencies"
  },
  "dependencies": {
    "@index0/contracts": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^20.12.0",
    "@types/vscode": "1.88.0",
    "@vscode/vsce": "^4.1.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.4.5"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/INDEX0-RESEARCH-LABS/INDEX0.git"
  }
}