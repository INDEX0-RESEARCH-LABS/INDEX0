{
  "name": "index0",
  "version": "0.1.0",
  "private": true,
  "description": "INDEX0 AI — Sovereign Multi-Agent AI Software Engineering Platform",
  "type": "module",
  "packageManager": "pnpm@12.4.2",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test && pnpm run test:contracts && pnpm run test:fixtures && pnpm run test:gateway && pnpm run test:openhands && pnpm run test:mcp && pnpm run test:telemetry && pnpm run test:billing",
    "test:contracts": "node --test tests/contracts/**/*.test.ts",
    "test:fixtures": "node --test tests/fixtures/**/*.test.ts",
    "test:gateway": "node --test tests/gateway/**/*.test.ts",
    "test:openhands": "node --test tests/openhands/**/*.test.ts",
    "test:mcp": "node --test tests/mcp/**/*.test.ts",
    "test:telemetry": "node --test tests/telemetry/**/*.test.ts",
    "test:billing": "node --test tests/billing/**/*.test.ts",
    "test:license": "pnpm --filter @index0/ai test:license",
    "license:check": "bash scripts/license-check.sh",
    "clean": "turbo run clean",
    "postinstall": "pnpm db:generate",
    "db:generate": "pnpm --filter @index0/db db:generate",
    "db:validate": "pnpm --filter @index0/db db:validate",
    "db:push": "pnpm --filter @index0/db db:push",
    "db:seed": "pnpm --filter @index0/db db:seed",
    "infra:up": "docker compose -f infra/compose/docker-compose.yml up -d",
    "infra:down": "docker compose -f infra/compose/docker-compose.yml down",
    "infra:config": "docker compose -f infra/compose/docker-compose.yml config",
    "openhands:up": "docker compose -f infra/compose/docker-compose.yml up -d openhands",
    "openhands:down": "docker compose -f infra/compose/docker-compose.yml stop openhands",
    "canvas:dev": "cd agent-canvas/frontend && pnpm dev",
    "canvas:mock": "cd agent-canvas/frontend && pnpm dev:mock"
  },
  "devDependencies": {
    "@index0/contracts": "workspace:*",
    "prettier": "^3.2.5",
    "turbo": "^2.4.4",
    "typescript": "^5.4.5"
  }
}
