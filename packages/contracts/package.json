{
  "name": "@index0/contracts",
  "version": "0.1.0",
  "private": true,
  "description": "Authoritative TypeScript contracts, schemas, and event models for INDEX0 AI",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.js"
    },
    "./v1/*": {
      "types": "./dist/v1/*/index.d.ts",
      "import": "./dist/v1/*/index.mjs",
      "default": "./dist/v1/*/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "tsc --noEmit"
  },
  "devDependencies": {
    "typescript": "^5.4.5"
  }
}
