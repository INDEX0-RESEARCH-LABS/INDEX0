{
  "name": "index0",
  "version": "0.1.0",
  "type": "module",
  "private": false,
  "description": "INDEX0 AI — Sovereign Software Engineering CLI",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "index0": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "index0",
    "ai",
    "cli",
    "sovereign",
    "software-engineering",
    "agent",
    "code-review",
    "terminal"
  ],
  "homepage": "https://ai.index0.in",
  "repository": {
    "type": "git",
    "url": "https://github.com/INDEX0-RESEARCH-LABS/INDEX0"
  },
  "license": "AGPL-3.0",
  "author": "INDEX0 AI Inc.",
  "scripts": {
    "build": "tsc && chmod +x dist/cli.js",
    "typecheck": "tsc --noEmit",
    "test": "tsc && chmod +x dist/cli.js && node --test test/*.test.ts",
    "prepublishOnly": "pnpm build"
  },
  "devDependencies": {
    "@types/node": "^20.12.0",
    "typescript": "^5.4.5"
  }
}
