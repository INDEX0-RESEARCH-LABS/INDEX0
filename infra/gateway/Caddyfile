{
    admin off
}

# ==============================================================================
# 1. Primary Platform Domain (ai.index0.in) + IP & Port Fallbacks
# ==============================================================================
ai.index0.in, http://ai.index0.in, http://20.106.136.209, :80, :443, :8000 {
    tls internal
    encode gzip zstd

    log {
        output stdout
        format json
    }

    # Security & CORS Headers
    header {
        X-Frame-Options "SAMEORIGIN"
        X-Content-Type-Options "nosniff"
        X-XSS-Protection "1; mode=block"
        Referrer-Policy "strict-origin-when-cross-origin"
        -Server
        Access-Control-Allow-Origin "http://localhost:5173"
        Access-Control-Allow-Methods "GET, POST, PUT, PATCH, DELETE, OPTIONS"
        Access-Control-Allow-Headers "Authorization, Content-Type, X-Request-ID"
    }

    # Health check endpoint for Gateway
    handle /health {
        header Content-Type "application/json"
        respond `{"status":"ok","gateway":"caddy","engine":"index0-gateway"}` 200
    }

    # Universal One-Line Installer & Distribution Artifacts
    handle /install.sh {
        header Content-Type "text/x-shellscript; charset=utf-8"
        header Cache-Control "no-cache, no-store, must-revalidate"
        root * /srv
        file_server
    }

    handle /install.ps1 {
        header Content-Type "text/plain; charset=utf-8"
        header Cache-Control "no-cache, no-store, must-revalidate"
        root * /srv
        file_server
    }

    handle /index0-cli.tar.gz {
        header Content-Type "application/gzip"
        header Cache-Control "public, max-age=3600"
        root * /srv
        file_server
    }

    handle /index0-engine* {
        header Content-Type "application/gzip"
        header Cache-Control "public, max-age=86400"
        root * /srv
        file_server
    }

    handle /releases/* {
        header Content-Type "application/gzip"
        header Cache-Control "public, max-age=86400"
        root * /srv
        file_server
    }

    # Zitadel Identity Provider & Admin Console
    handle /auth* {
        reverse_proxy zitadel:8085 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
        }
    }

    handle /ui* {
        reverse_proxy zitadel:8085 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
        }
    }

    # Temporal Workflow Orchestration UI
    handle /temporal* {
        reverse_proxy temporal-ui:8233 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
        }
    }

    # LiteLLM OpenAI-Compatible Router (Azure OpenAI Backend)
    handle /v1* {
        reverse_proxy litellm:4000 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
        }
    }

    # Agent Orchestrator (LangGraph 4-Tier)
    handle /orchestrator* {
        reverse_proxy agent-orchestrator:8000 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
        }
    }

    # Sandbox Manager (MicroVM / E2B / Docker execution engine)
    handle /sandbox* {
        reverse_proxy sandbox-manager:4001 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
        }
    }

    # ClickHouse Analytics HTTP Interface
    handle /analytics* {
        reverse_proxy clickhouse:8123 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
        }
    }

    # Static Web IDE Client
    handle /ide* {
        reverse_proxy host.docker.internal:5173 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
        }
    }

    # Sovereign Cloud IDE (code-server / Code-OSS Web)
    handle /canvas* {
        reverse_proxy code-server:8443 {
            flush_interval -1
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
            header_up Upgrade {>Upgrade}
            header_up Connection {>Connection}
        }
    }

    handle /code* {
        reverse_proxy code-server:8443 {
            flush_interval -1
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
            header_up Upgrade {>Upgrade}
            header_up Connection {>Connection}
        }
    }

    # Next.js API Endpoints
    handle /api/billing* {
        reverse_proxy host.docker.internal:3005 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
        }
    }

    handle /api/newsletter* {
        reverse_proxy host.docker.internal:3005 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
        }
    }

    # Next.js Landing Platform (Port 3005 on host)
    handle {
        reverse_proxy host.docker.internal:3005 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
        }
    }
}

# ==============================================================================
# 2. Dedicated Sovereign Cloud IDE Subdomain (ide.index0.in, canvas.index0.in)
# ==============================================================================
ide.index0.in, canvas.index0.in, ide.index0.in:8000, canvas.index0.in:8000 {
    tls internal
    encode gzip zstd

    handle {
        reverse_proxy code-server:8443 {
            flush_interval -1
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
            header_up Upgrade {>Upgrade}
            header_up Connection {>Connection}
        }
    }
}

