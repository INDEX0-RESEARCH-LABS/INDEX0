{
    admin off
}

# ==============================================================================
# 1. Primary Platform Domain (ai.index0.in) + IP & Port Fallbacks
# ==============================================================================
ai.index0.in, http://ai.index0.in, http://20.106.136.209, :80, :443, :8000 {
    tls internal
    encode gzip zstd

    log {
        output stdout
        format json
    }

    # Security & CORS Headers
    header {
        X-Frame-Options "SAMEORIGIN"
        X-Content-Type-Options "nosniff"
        X-XSS-Protection "1; mode=block"
        Referrer-Policy "strict-origin-when-cross-origin"
        -Server
    }

    # Health check endpoint for Gateway
    handle /health {
        header Content-Type "application/json"
        respond `{"status":"ok","gateway":"caddy","domain":"ai.index0.in","engine":"index0-gateway"}` 200
    }

    # Zitadel Identity Provider & Admin Console
    handle /auth* {
        reverse_proxy zitadel:8085 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
        }
    }

    handle /ui* {
        reverse_proxy zitadel:8085 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
        }
    }

    # Temporal Workflow Orchestration UI
    handle /temporal* {
        reverse_proxy temporal-ui:8233 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
        }
    }

    # LiteLLM OpenAI-Compatible Router (Azure OpenAI Backend)
    handle /v1* {
        reverse_proxy litellm:4000 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
        }
    }

    # Agent Orchestrator (LangGraph 4-Tier)
    handle /orchestrator* {
        reverse_proxy agent-orchestrator:8000 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
        }
    }

    # ClickHouse Analytics HTTP Interface
    handle /analytics* {
        reverse_proxy clickhouse:8123 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
        }
    }

    # Static Web IDE Client
    handle /ide* {
        reverse_proxy host.docker.internal:5173 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
        }
    }

    # OpenHands Monaco Workbench & Static Assets
    handle /canvas* {
        reverse_proxy openhands:3000 {
            flush_interval -1
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
        }
    }

    handle /assets* {
        header Cache-Control "public, max-age=31536000, immutable"
        reverse_proxy openhands:3000 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
        }
    }

    handle /locales* {
        reverse_proxy openhands:3000 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
        }
    }

    # Next.js API Endpoints
    handle /api/billing* {
        reverse_proxy host.docker.internal:3005 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
        }
    }

    handle /api/newsletter* {
        reverse_proxy host.docker.internal:3005 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
        }
    }

    # OpenHands Workbench APIs (settings, options, conversations, config, etc.)
    handle /api/* {
        reverse_proxy openhands:3000 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
        }
    }

    handle /ws* {
        reverse_proxy openhands:3000 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
        }
    }

    # Next.js Landing Platform (Port 3005 on host)
    handle {
        reverse_proxy host.docker.internal:3005 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
        }
    }
}

# ==============================================================================
# 2. Dedicated OpenHands Subdomain (canvas.index0.in)
# ==============================================================================
canvas.index0.in {
    tls internal
    encode gzip zstd

    handle /assets* {
        header Cache-Control "public, max-age=31536000, immutable"
        reverse_proxy openhands:3000 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
        }
    }

    handle {
        reverse_proxy openhands:3000 {
            flush_interval -1
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
        }
    }
}
